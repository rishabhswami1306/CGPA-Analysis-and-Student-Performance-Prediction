# Environment & Server Config
FLASK_ENV=development
FLASK_APP=app.py
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key

# Database Config (MongoDB Atlas or Local)
MONGO_URI=mongodb://localhost:27017/cgpa_analytics
MONGO_DB_NAME=cgpa_analytics

# Redis Config (Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Security & CORS
CORS_ORIGIN=http://localhost:5000
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Mail Server (for password resets - simulated in dev if empty)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=noreply@institute.edu
MAIL_PASSWORD=secret
MAIL_DEFAULT_SENDER=noreply@institute.edu
